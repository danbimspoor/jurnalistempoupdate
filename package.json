  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"Vite,Wran\" -c \"cyan,magenta\" \"vite --port 3000 --host 0.0.0.0\" \"wrangler pages dev . --port 8788 --ip 0.0.0.0 --local --inspector-port 0\"",
