    "concurrently": "^10.0.4",
    "dotenv": "^17.2.3",
    "framer-motion": "^13.0.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "wrangler": "^4.118.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
